# Generated by scripts/bootstrap.sh. Holds the relay nsec, the push nsec and
# the LiveKit secret — the three things in this stack that cannot be rotated
# without consequences. Never commit it.
.env
.env.*
!.env.example

# Local compose scratch
docker-compose.override.yml

# The Armada images publisher nsec (scripts/publish-images.sh). Signs the
# kind-30624 events that name the pulled images on ncontainer; the image name
# IS this key, so it can never be rotated without a stack-wide reference change.
.images.env
