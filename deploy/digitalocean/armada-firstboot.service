# Runs the stack's firstboot provisioner on the Packer/Marketplace image (Path
# B). Installed and enabled by packer/provision.sh so the FIRST real boot of a
# droplet made from the snapshot brings the stack up — after the operator has
# put DOMAIN/EMAIL in /etc/armada/deploy.env (via the droplet's user-data, a DO
# Marketplace form, or by hand).
#
# WHY IT RUNS ON EVERY BOOT, not just once. firstboot.sh is idempotent and cheap
# when there is nothing to do: a done-marker (/var/lib/armada/.provisioned)
# short-circuits the expensive work, and an UNCONFIGURED box exits 0 without
# writing the marker. So the unit staying enabled means "retry until configured"
# — the operator can boot the droplet, then set the domain and reboot (or
# `systemctl start armada-firstboot`) and it just works. Once provisioned,
# Docker's own `restart: unless-stopped` keeps the stack up across reboots and
# this unit's re-run is a no-op that reconciles `up` and returns.
#
# The unit is NOT disabled after success on purpose: a re-run reconciles the
# compose state (brings anything down back up) and is harmless.

[Unit]
Description=Armada stack first-boot provisioner
# Needs the network for git clone / image pull / ACME, and Docker for `up`.
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
# The stack is baked at /opt/armada/stack by provision.sh. firstboot.sh is
# self-locating (STACK_DIR is two levels up from its own path), so this is the
# only place the bake location is named.
ExecStart=/usr/bin/env bash /opt/armada/stack/deploy/digitalocean/firstboot.sh
RemainAfterExit=yes
# A slow first build (client compile + image pulls) must not be killed.
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
