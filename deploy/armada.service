# armada as a system service, running as its own unprivileged user. Install
# the binary at /usr/local/bin/armada and the config at
# /etc/armada/armada.toml, with storage_dir = "/var/lib/armada"; systemd
# makes that directory and hands it to the armada user.
#
#   useradd --system --home-dir /var/lib/armada --shell /usr/sbin/nologin armada
#   cp armada.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now armada
[Unit]
Description=Armada (web app, relay, Blossom, AV broker)
After=network-online.target
Wants=network-online.target

[Service]
User=armada
Group=armada
ExecStart=/usr/local/bin/armada --config /etc/armada/armada.toml
Restart=on-failure
RestartSec=5
StateDirectory=armada
StateDirectoryMode=0700
# Ports 80 and 443 without root, for [tls] acme.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
# Files it makes are its own: keys, the certificate, the databases.
UMask=0077
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
# IP for everything it serves and fetches; netlink for resolving names.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# A call the filter misses fails, rather than killing the service.
SystemCallErrorNumber=EPERM
# A file descriptor per relay connection.
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
