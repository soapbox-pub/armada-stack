# One Caddyfile for all three modes. The site addresses arrive as full URLs
# from .env, and the SCHEME IN THE ADDRESS is the entire TLS switch:
#
#   https://armada.example.com   direct: automatic Let's Encrypt
#   http://armada.example.com    behind an external TLS-terminating proxy
#   http://armada.localhost      local testing
#
# Nothing below is mode-aware except trusted_proxies.

{
	# Unused unless a site address is https.
	email {$ACME_EMAIL}

	servers {
		# Who is allowed to tell us the real client IP. Behind an external
		# proxy this is that proxy's address; otherwise it stays loopback,
		# which no real client can ever connect from, so nothing is trusted.
		#
		# This is what makes {client_ip} below mean the CLIENT rather than the
		# nearest hop, in both modes, without either service having to know
		# whether it is double-proxied.
		trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1/32}
	}
}

# ── The client ───────────────────────────────────────────────────────────────
# Cache-Control, CSP and the SPA fallback all come from the client image's own
# nginx.conf. Re-stating any of them here would be a second copy that drifts.
{$ARMADA_SITE} {
	encode zstd gzip
	reverse_proxy armada:80
}

# ── Voice ────────────────────────────────────────────────────────────────────
# The broker and the SFU MUST share one origin: the broker hands the client a
# bare `wss://` URL and the LiveKit SDK appends `/rtc` to it, so the signal
# socket lands back on this same host.
#
# `handle` blocks are mutually exclusive and evaluated in order. /twirp — the
# LiveKit server API, which can create and destroy any room — is deliberately
# absent, so it exists only on the internal network.
{$AV_SITE} {
	@livekit path /rtc /rtc/*
	handle @livekit {
		# Parameterised for one reason: docker-compose.hostnet.yml moves the SFU
		# into the host network namespace, where it has no service DNS and this
		# has to become the host gateway instead.
		reverse_proxy {$LIVEKIT_UPSTREAM:livekit:7880}
	}

	handle /.well-known/concord/av* {
		reverse_proxy broker:8080 {
			# The broker takes the RIGHTMOST X-Forwarded-For entry, which is
			# correct when exactly one proxy appends to it — but behind a
			# second proxy the rightmost entry is THIS server, and every
			# client would collapse into one rate-limit bucket. Replacing the
			# header with the single resolved client IP keeps rightmost
			# meaning the client no matter how deep the chain is.
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		respond "armada-av" 200
	}
}

# ── Relay ────────────────────────────────────────────────────────────────────
# WebSocket upgrades need no special directive in Caddy v2.
{$RELAY_SITE} {
	reverse_proxy relay:13131 {
		# header_up REPLACES, which is the point. The relay trusts the
		# LEFTMOST entry of the header named by IP_HEADER; pointing it at
		# X-Forwarded-For would trust a value the client sent, because Caddy
		# appends to XFF rather than overwriting it.
		header_up X-Real-IP {client_ip}
	}
}

# ── Media ────────────────────────────────────────────────────────────────────
{$BLOSSOM_SITE} {
	reverse_proxy blossom:3000 {
		header_up X-Real-IP {client_ip}
	}
}
